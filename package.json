{
  "name": "kanban-ai-agent-monorepo",
  "version": "0.0.1",
  "description": "AI-powered Kanban management system with intelligent agents",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "kan-back",
    "kan-front"
  ],
  "scripts": {
    "start:back": "cd kan-back && yarn start:dev",
    "start:front": "cd kan-front && yarn dev",
    "start:dev": "concurrently \"yarn start:back\" \"yarn start:front\"",
    "build": "yarn build:back && yarn build:front",
    "build:back": "cd kan-back && yarn build",
    "build:front": "cd kan-front && yarn build",
    "lint": "yarn lint:back && yarn lint:front",
    "lint:back": "cd kan-back && yarn lint",
    "lint:front": "cd kan-front && yarn lint",
    "test": "cd kan-back && yarn test",
    "test:all": "cd kan-back && yarn test:all",
    "db:up": "docker-compose -f docker-compose.dev.yml up -d postgres redis",
    "db:down": "docker-compose -f docker-compose.dev.yml down",
    "db:logs": "docker-compose -f docker-compose.dev.yml logs -f postgres",
    "db:reset": "docker-compose -f docker-compose.dev.yml down -v && docker-compose -f docker-compose.dev.yml up -d postgres redis",
    "adminer": "docker-compose -f docker-compose.dev.yml up -d adminer",
    "clean:ports": "./scripts/clean-ports.sh",
    "setup": "yarn install && cd kan-back && yarn install && cd ../kan-front && yarn install"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.64.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bull": "^11.0.3",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/typeorm": "^11.0.0",
    "@types/body-parser": "^1.19.6",
    "@types/form-data": "^2.5.2",
    "@types/nodemailer": "^7.0.2",
    "@types/pdfkit": "^0.17.3",
    "@types/pg": "^8.15.5",
    "axios": "^1.12.2",
    "body-parser": "^2.2.0",
    "bull": "^4.16.5",
    "cache-manager": "^7.2.3",
    "cache-manager-redis-store": "^3.0.1",
    "chrono-node": "^2.9.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "form-data": "^4.0.4",
    "nodemailer": "^7.0.6",
    "openai": "^5.23.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "redis": "^5.8.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "telegraf": "^4.16.3",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "node_modules/(?!(uuid)/)"
    ],
    "preset": "ts-jest/presets/default-esm",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "globals": {
      "ts-jest": {
        "useESM": true
      }
    }
  }
}
