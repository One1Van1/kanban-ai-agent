{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/integration/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1"
  },
  "setupFilesAfterEnv": ["<rootDir>/test/setup/test-setup.ts"],
  "collectCoverageFrom": [
    "src/**/*.(t|j)s",
    "!src/**/*.spec.ts",
    "!src/**/*.interface.ts",
    "!src/**/index.ts"
  ],
  "coverageDirectory": "<rootDir>/coverage/integration",
  "coverageReporters": ["text", "lcov", "html"],
  "testTimeout": 30000,
  "maxWorkers": 1,
  "verbose": true,
  "forceExit": true,
  "detectOpenHandles": true
}
